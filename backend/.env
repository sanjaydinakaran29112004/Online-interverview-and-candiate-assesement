PORT=5000
NODE_ENV=development
DATABASE_URL="file:./dev.db"
JWT_SECRET="super-secret-jwt-key-ai-interview-platform-2025"
JWT_REFRESH_SECRET="super-secret-jwt-refresh-key-ai-interview-2025"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# AI Microservice URL
AI_SERVICE_URL="http://127.0.0.1:8000"

# Optional LLM integration
OPENAI_API_KEY=""
AI_FALLBACK_MODE="true"

# Client CORS URL
CLIENT_URL="http://localhost:5173"

# Upload Directory
UPLOAD_DIR="./uploads"
