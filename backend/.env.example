PORT=5000
NODE_ENV=production
# For PostgreSQL: DATABASE_URL="postgresql://username:password@localhost:5432/ai_interview_db?schema=public"
# For SQLite (local zero-setup): DATABASE_URL="file:./dev.db"
DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-secure-random-secret"
JWT_REFRESH_SECRET="replace-with-another-secure-secret"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

AI_SERVICE_URL="http://127.0.0.1:8000"
OPENAI_API_KEY=""
AI_FALLBACK_MODE="true"

CLIENT_URL="http://localhost:5173"
UPLOAD_DIR="./uploads"
