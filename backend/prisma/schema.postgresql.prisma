datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// PostgreSQL Production Schema (Identical models, supports native PostgreSQL database)

model User {
  id                   String                 @id @default(uuid())
  email                String                 @unique
  password             String
  name                 String
  role                 String                 @default("CANDIDATE")
  status               String                 @default("ACTIVE")
  avatarUrl            String?
  emailVerified        Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  candidateProfile     CandidateProfile?
  recruiterProfile     RecruiterProfile?
  interviewerProfile   InterviewerProfile?
  interviewParticipants InterviewParticipant[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  answersEvaluated     AnswerEvaluation[]
}

model CandidateProfile {
  id                   String                 @id @default(uuid())
  userId               String                 @unique
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone                String?
  headline             String?
  summary              String?
  education            String?
  experienceYears      Float                  @default(0)
  location             String?
  technicalSkills      String?
  portfolioUrl         String?
  linkedinUrl          String?
  githubUrl            String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  resumes              Resume[]
  applications         Application[]
  assessments          CandidateAssessment[]
  rankings             CandidateRanking[]
  skillAssessments     SkillAssessment[]
}

model RecruiterProfile {
  id                   String                 @id @default(uuid())
  userId               String                 @unique
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName          String
  department           String?
  designation          String?
  phone                String?
  website              String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  jobs                 Job[]
}

model InterviewerProfile {
  id                   String                 @id @default(uuid())
  userId               String                 @unique
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  technicalDomain      String?
  yearsOfExperience    Float                  @default(0)
  bio                  String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  interviewSlots       InterviewSlot[]
}

model Job {
  id                   String                 @id @default(uuid())
  title                String
  companyName          String
  description          String
  department           String?
  location             String
  employmentType       String                 @default("FULL_TIME")
  minExperience        Float                  @default(0)
  maxExperience        Float                  @default(10)
  educationalReq       String?
  salaryRange          String?
  openingsCount        Int                    @default(1)
  deadline             DateTime?
  status               String                 @default("PUBLISHED")
  recruiterId          String
  recruiter            RecruiterProfile       @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  skills               JobSkill[]
  applications         Application[]
  questionSets         QuestionSet[]
  rankings             CandidateRanking[]
}

model JobSkill {
  id                   String                 @id @default(uuid())
  jobId                String
  job                  Job                    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillName            String
  weight               Float                  @default(1.0)
  isRequired           Boolean                @default(true)
  minimumProficiency   String                 @default("INTERMEDIATE")
}

model Application {
  id                   String                 @id @default(uuid())
  jobId                String
  job                  Job                    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId          String
  candidate            CandidateProfile       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status               String                 @default("APPLIED")
  coverLetter          String?
  appliedAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  resumeAnalyses       ResumeAnalysis[]
  interviews           Interview[]
  assessments          CandidateAssessment[]
}

model Resume {
  id                   String                 @id @default(uuid())
  candidateId          String
  candidate            CandidateProfile       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fileName             String
  originalName         String
  fileUrl              String
  fileSize             Int
  mimeType             String
  extractedText        String?
  isCurrent            Boolean                @default(true)
  createdAt            DateTime               @default(now())

  analyses             ResumeAnalysis[]
}

model ResumeAnalysis {
  id                   String                 @id @default(uuid())
  resumeId             String
  resume               Resume                 @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  applicationId        String?
  application          Application?           @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  extractedSkills      String
  matchedSkills        String
  missingSkills        String
  experienceSummary    String?
  compatibilityScore   Float                  @default(0)
  scoreExplanation     String?
  rawAiOutput          String?
  analyzedAt           DateTime               @default(now())
}

model Interview {
  id                   String                 @id @default(uuid())
  applicationId        String
  application          Application            @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title                String
  interviewType        String                 @default("ONLINE_VIDEO")
  scheduledStartTime   DateTime
  scheduledEndTime     DateTime
  actualStartTime      DateTime?
  actualEndTime        DateTime?
  roomCode             String                 @unique
  status               String                 @default("SCHEDULED")
  meetingNotes         String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  participants         InterviewParticipant[]
  answers              InterviewAnswer[]
  recording            InterviewRecording?
  assessmentReport     AssessmentReport?
}

model InterviewParticipant {
  id                   String                 @id @default(uuid())
  interviewId          String
  interview            Interview              @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  userId               String
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  participantRole      String
  joinedAt             DateTime?
  leftAt               DateTime?
  consentGiven         Boolean                @default(false)
}

model InterviewSlot {
  id                   String                 @id @default(uuid())
  interviewerId        String
  interviewer          InterviewerProfile     @relation(fields: [interviewerId], references: [id], onDelete: Cascade)
  startTime            DateTime
  endTime              DateTime
  isBooked             Boolean                @default(false)
  createdAt            DateTime               @default(now())
}

model InterviewQuestion {
  id                   String                 @id @default(uuid())
  questionSetId        String?
  questionSet          QuestionSet?           @relation(fields: [questionSetId], references: [id], onDelete: SetNull)
  title                String
  description          String
  category             String                 @default("TECHNICAL")
  difficulty           String                 @default("INTERMEDIATE")
  skillEvaluated       String
  expectedConcepts     String
  evaluationCriteria   String?
  maxScore             Float                  @default(100)
  timeLimitSeconds     Int                    @default(180)
  isAiGenerated        Boolean                @default(false)
  createdAt            DateTime               @default(now())

  answers              InterviewAnswer[]
}

model QuestionSet {
  id                   String                 @id @default(uuid())
  jobId                String?
  job                  Job?                   @relation(fields: [jobId], references: [id], onDelete: SetNull)
  title                String
  description          String?
  category             String                 @default("GENERAL")
  targetRole           String?
  createdAt            DateTime               @default(now())

  questions            InterviewQuestion[]
}

model InterviewAnswer {
  id                   String                 @id @default(uuid())
  interviewId          String
  interview            Interview              @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  questionId           String
  question             InterviewQuestion      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  candidateAnswerText  String
  submittedAt          DateTime               @default(now())
  timeTakenSeconds     Int                    @default(0)

  evaluation           AnswerEvaluation?
}

model AnswerEvaluation {
  id                   String                 @id @default(uuid())
  answerId             String                 @unique
  answer               InterviewAnswer        @relation(fields: [answerId], references: [id], onDelete: Cascade)
  technicalCorrectness Float                  @default(0)
  semanticRelevance    Float                  @default(0)
  conceptualUnderstanding Float               @default(0)
  completeness         Float                  @default(0)
  keywordCoverage      Float                  @default(0)
  finalScore           Float                  @default(0)
  strengthsFeedback    String?
  missingConcepts      String?
  improvementAreas     String?
  modelUsed            String                 @default("ScikitLearn-NLP-v1")
  humanOverrideScore   Float?
  overrideReason       String?
  evaluatorId          String?
  evaluator            User?                  @relation(fields: [evaluatorId], references: [id], onDelete: SetNull)
  evaluatedAt          DateTime               @default(now())
}

model SkillAssessment {
  id                   String                 @id @default(uuid())
  candidateId          String
  candidate            CandidateProfile       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assessmentId         String?
  assessment           CandidateAssessment?   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  skillName            String
  score                Float                  @default(0)
  weight               Float                  @default(1.0)
  level                String                 @default("INTERMEDIATE")
  evaluatedAt          DateTime               @default(now())
}

model CandidateAssessment {
  id                   String                 @id @default(uuid())
  candidateId          String
  candidate            CandidateProfile       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applicationId        String?
  application          Application?           @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  technicalScore       Float                  @default(0)
  interviewScore       Float                  @default(0)
  resumeScore          Float                  @default(0)
  overallScore         Float                  @default(0)
  strengthsSummary     String?
  weaknessesSummary    String?
  status               String                 @default("COMPLETED")
  assessedAt           DateTime               @default(now())

  skillAssessments     SkillAssessment[]
  report               AssessmentReport?
}

model CandidateRanking {
  id                   String                 @id @default(uuid())
  jobId                String
  job                  Job                    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId          String
  candidate            CandidateProfile       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  overallRank          Int                    @default(1)
  compositeScore       Float                  @default(0)
  skillMatchScore      Float                  @default(0)
  interviewScore       Float                  @default(0)
  experienceScore      Float                  @default(0)
  rankExplanation      String?
  recruitmentStage     String                 @default("SCREENING")
  updatedAt            DateTime               @default(now())

  @@unique([jobId, candidateId])
}

model InterviewRecording {
  id                   String                 @id @default(uuid())
  interviewId          String                 @unique
  interview            Interview              @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  fileUrl              String
  durationSeconds      Int                    @default(0)
  candidateConsent     Boolean                @default(false)
  interviewerConsent   Boolean                @default(false)
  retentionExpiryDate  DateTime?
  createdAt            DateTime               @default(now())
}

model Notification {
  id                   String                 @id @default(uuid())
  userId               String
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                String
  message              String
  type                 String                 @default("INFO")
  link                 String?
  isRead               Boolean                @default(false)
  createdAt            DateTime               @default(now())
}

model AssessmentReport {
  id                   String                 @id @default(uuid())
  interviewId          String?                @unique
  interview            Interview?             @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  assessmentId         String?                @unique
  assessment           CandidateAssessment?   @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  reportData           String
  pdfUrl               String?
  recruiterRecommendation String?
  finalStatus          String                 @default("FINALIZED")
  generatedAt          DateTime               @default(now())
}

model AuditLog {
  id                   String                 @id @default(uuid())
  userId               String?
  user                 User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  action               String
  entity               String
  entityId             String?
  details              String?
  ipAddress            String?
  createdAt            DateTime               @default(now())
}
