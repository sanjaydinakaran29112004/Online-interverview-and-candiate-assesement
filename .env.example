# Root Environment Template
# AI-Based Online Interview and Candidate Assessment Platform

# Backend
PORT=5000
NODE_ENV=development
# Choose one of:
# DATABASE_URL="file:./dev.db" (SQLite for immediate local development)
# DATABASE_URL="postgresql://user:password@localhost:5432/interview_platform?schema=public" (PostgreSQL)
DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-secure-secret-key-32chars"
JWT_REFRESH_SECRET="replace-with-a-secure-refresh-secret-32chars"
CLIENT_URL="http://localhost:5173"

# AI Microservice
AI_SERVICE_PORT=8000
AI_SERVICE_URL="http://127.0.0.1:8000"
OPENAI_API_KEY=""
AI_FALLBACK_MODE="true"

# Frontend
VITE_API_URL="http://localhost:5000/api"
VITE_SOCKET_URL="http://localhost:5000"
