{
  "name": "ai-interview-platform-root",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Based Online Interview and Candidate Assessment Platform - Root Orchestration",
  "scripts": {
    "setup:backend": "cd backend && npm install && npm run db:setup",
    "setup:frontend": "cd frontend && npm install",
    "setup:ai": "cd ai-service && pip install -r requirements.txt",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:ai": "cd ai-service && uvicorn app.main:app --reload --port 8000",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build"
  }
}
